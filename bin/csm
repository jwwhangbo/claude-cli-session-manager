#!/bin/sh
# Runs the prebuilt bundle with Node (>= 22), falling back to Bun.
self="$0"
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case "$link" in /*) self="$link" ;; *) self="$(dirname "$self")/$link" ;; esac
done
bundle="$(cd "$(dirname "$self")/.." && pwd)/dist/csm.js"

if command -v node >/dev/null 2>&1 && [ "$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null)" -ge 22 ] 2>/dev/null; then
  exec node "$bundle" "$@"
elif command -v bun >/dev/null 2>&1; then
  exec bun "$bundle" "$@"
fi
echo "csm: needs Node.js >= 22 or Bun on PATH" >&2
exit 127
