# dependencies (bun install); bun.lock IS committed
node_modules

# build output
# dist/csm.js is committed: it is the prebuilt CLI the plugin ships.
# Anything else a build drops in dist/ (sourcemaps, stray chunks) is not.
dist/*
!dist/csm.js
out
*.tgz

# transcripts written by `csm export` while testing in the repo
claude-session-*.md

# code coverage
coverage
*.lcov

# logs
logs
*.log
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# dotenv environment variable files
.env
.env.*
!.env.example

# caches
.eslintcache
.cache
*.tsbuildinfo

# Claude Code per-user local settings (project .claude/settings.json stays shared)
.claude/settings.local.json

# editors
.idea
.vscode/*
!.vscode/extensions.json
*.swp
*~

# OS
.DS_Store
Thumbs.db
